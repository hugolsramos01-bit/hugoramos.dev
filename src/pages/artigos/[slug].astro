---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
const canonical = new URL(`/artigos/${article.id}`, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: (article.data.updatedAt ?? article.data.publishedAt).toISOString(),
  inLanguage: 'pt-BR',
  articleSection: 'Engenharia de Dados e Software',
  image: new URL('/og.png', Astro.site).toString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  author: {
    '@type': 'Person',
    '@id': 'https://hugoramos.dev/#person',
    name: 'Hugo Ramos',
    url: 'https://hugoramos.dev/',
  },
  publisher: {
    '@type': 'Person',
    '@id': 'https://hugoramos.dev/#person',
    name: 'Hugo Ramos',
  },
  keywords: article.data.tags.join(', '),
};
---

<BaseLayout
  title={`${article.data.title} — Hugo Ramos`}
  description={article.data.description}
  canonical={canonical}
  jsonLd={jsonLd}
  ogType="article"
  publishedTime={article.data.publishedAt.toISOString()}
  modifiedTime={(article.data.updatedAt ?? article.data.publishedAt).toISOString()}
  articleTags={article.data.tags}
>
  <header class="page-header">
    <div class="narrow">
      <p class="eyebrow">Artigo</p>
      <h1>{article.data.title}</h1>
      <p>{article.data.description}</p>
      <div class="inline-list">
        <time datetime={article.data.publishedAt.toISOString()}>
          {article.data.publishedAt.toLocaleDateString('pt-BR', {
            day: '2-digit',
            month: 'long',
            year: 'numeric',
          })}
        </time>
        <span>·</span>
        <span>Hugo Ramos</span>
      </div>
    </div>
  </header>

  <article class="content narrow">
    <Content />
  </article>

  <section class="section">
    <div class="narrow">
      <a href="/artigos">← Voltar para artigos</a>
    </div>
  </section>
</BaseLayout>
