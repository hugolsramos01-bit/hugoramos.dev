---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const description = 'Artigos técnicos de Hugo Ramos sobre Engenharia de Dados, Engenharia de Software, PostgreSQL, FastAPI, MCP, automação e sistemas orientados a dados.';
const canonical = new URL('/artigos', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: 'Artigos — Hugo Ramos',
      description,
      inLanguage: 'pt-BR',
      mainEntity: { '@id': `${canonical}#articles` },
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#articles`,
      name: 'Artigos técnicos de Hugo Ramos',
      numberOfItems: articles.length,
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      itemListElement: articles.map((article, index) => {
        const url = new URL(`/artigos/${article.id}`, Astro.site).toString();
        return {
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'Article',
            '@id': `${url}#article`,
            url,
            headline: article.data.title,
            description: article.data.description,
            datePublished: article.data.publishedAt.toISOString(),
            dateModified: (article.data.updatedAt ?? article.data.publishedAt).toISOString(),
            inLanguage: 'pt-BR',
            author: { '@id': 'https://hugoramos.dev/#person' },
          },
        };
      }),
    },
  ],
};
---

<BaseLayout title="Artigos — Hugo Ramos" description={description} canonical={canonical} jsonLd={jsonLd}>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">Artigos</p>
      <h1>Decisões técnicas, contexto e aprendizados.</h1>
      <p>
        Textos sobre problemas que surgem na construção de pipelines, APIs, aplicações e ferramentas de desenvolvimento.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="article-list">
        {articles.map((article) => (
          <a class="article-row" href={`/artigos/${article.id}`}>
            <time datetime={article.data.publishedAt.toISOString()}>
              {article.data.publishedAt.toLocaleDateString('pt-BR', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
              })}
            </time>
            <div>
              <div class="article-meta"><span class="article-kind"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.75h9l3 3V20.25H6V3.75Zm8.25 0v3h3M8.5 10h7M8.5 13h7M8.5 16h4" /></svg>Artigo técnico</span><span>6 min de leitura</span></div>
              <h2>{article.data.title}</h2>
              <p>{article.data.description}</p>
              <div class="inline-list" aria-label="Temas do artigo">
                {article.data.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
