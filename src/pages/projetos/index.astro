---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => data.public))
  .sort((a, b) => a.data.order - b.data.order);

const description = 'Projetos de Hugo Ramos em Engenharia de Dados, Engenharia de Software, APIs, automação, geoespacial e ferramentas para agentes de IA.';
const canonical = new URL('/projetos', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: 'Projetos — Hugo Ramos',
      description,
      inLanguage: 'pt-BR',
      mainEntity: { '@id': `${canonical}#projects` },
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#projects`,
      name: 'Projetos selecionados de Hugo Ramos',
      numberOfItems: projects.length,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: projects.map((project, index) => {
        const url = new URL(`/projetos/${project.id}`, Astro.site).toString();
        return {
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'CreativeWork',
            '@id': `${url}#project`,
            url,
            name: project.data.title,
            description: project.data.summary,
          },
        };
      }),
    },
  ],
};
---

<BaseLayout title="Projetos — Hugo Ramos" description={description} canonical={canonical} jsonLd={jsonLd}>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">Projetos</p>
      <h1>Sistemas, dados e ferramentas em produção de valor.</h1>
      <p>
        Uma seleção de projetos em que atuei diretamente no desenvolvimento, arquitetura de dados, backend,
        interfaces, automação ou evolução técnica.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="project-list">
        {projects.map((project, index) => (
          <ProjectCard
            index={String(index + 1).padStart(2, '0')}
            title={project.data.title}
            summary={project.data.summary}
            slug={project.id}
            status={project.data.status}
            stack={project.data.stack}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
