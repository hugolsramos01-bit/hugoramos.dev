---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Publicações e apresentações de Hugo Ramos relacionadas a Engenharia de Dados, transparência, patrimônio público e transformação digital.';
---

<BaseLayout title="Publicações — Hugo Ramos" description={description}>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">Publicações</p>
      <h1>Pesquisa aplicada e apresentação de soluções.</h1>
      <p>
        Trabalhos que documentam decisões, resultados e aprendizados desenvolvidos a partir de projetos técnicos reais.
      </p>
    </div>
  </header>

  <section class="section publications-section">
    <div class="container">
      <article class="publication-card">
        <div class="publication-mark"><span>XV</span><small>CONSAD<br />2026</small></div>
        <div class="publication-copy">
          <p class="eyebrow">XV CONSAD · Fortaleza</p>
          <h2>Transparência ativa no patrimônio imobiliário</h2>
          <p class="publication-lead">Dados abertos por camadas, rastreabilidade e auditoria contínua.</p>
          <p>
            Trabalho técnico relacionado ao Atlas.PE, desenvolvido no contexto da gestão do patrimônio imobiliário de Pernambuco.
            O artigo aborda a organização de dados em camadas, histórico de alterações, transparência ativa e mecanismos de auditoria.
          </p>
          <div class="actions">
            <a class="button secondary" href="/projetos/atlas-pe">Ver projeto Atlas.PE</a>
          </div>
        </div>
      </article>

      <article class="publication-card publication-card-secondary">
        <div class="publication-mark"><span>MAP</span><small>GEOPE<br />2026</small></div>
        <div class="publication-copy">
          <p class="eyebrow">Apresentação técnica · XV CONSAD</p>
          <h2>GeoPE e a dimensão territorial da gestão patrimonial</h2>
          <p>
            O GeoPE integrou os trabalhos apresentados no congresso, com foco no uso de dados geoespaciais para consulta e apoio à decisão.
          </p>
          <div class="actions">
            <a class="button secondary" href="/projetos/geope">Ver projeto GeoPE</a>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
