---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Contato profissional de Hugo Ramos para oportunidades em Engenharia de Dados, Engenharia de Software, Python, APIs e sistemas orientados a dados.';
const canonical = new URL('/contato', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: 'Contato — Hugo Ramos',
      description,
      inLanguage: 'pt-BR',
      mainEntity: { '@id': 'https://hugoramos.dev/#person' },
    },
    {
      '@type': 'Person',
      '@id': 'https://hugoramos.dev/#person',
      name: 'Hugo Ramos',
      url: 'https://hugoramos.dev/',
      email: 'mailto:hugolsramos01@gmail.com',
      sameAs: [
        'https://www.linkedin.com/in/hugo-sramos/',
        'https://github.com/hugolsramos01-bit',
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'professional inquiries',
        email: 'hugolsramos01@gmail.com',
        availableLanguage: 'Portuguese',
      },
    },
  ],
};
---

<BaseLayout title="Contato — Hugo Ramos" description={description} canonical={canonical} jsonLd={jsonLd}>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">Contato</p>
      <h1>Vamos conversar.</h1>
      <p>
        Para oportunidades profissionais, projetos, tecnologia ou troca técnica, estes são os melhores canais.
      </p>
    </div>
  </header>

  <section class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <a class="contact-card" href="mailto:hugolsramos01@gmail.com">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.75 5.5h16.5v13H3.75v-13Zm1 1 7.25 5.25 7.25-5.25M4.75 17.5l5.1-4.25m9.4 4.25-5.1-4.25" /></svg>
          <span><small>E-mail</small><strong>hugolsramos01@gmail.com</strong></span>
        </a>
        <a class="contact-card" href="https://www.linkedin.com/in/hugo-sramos/" rel="me">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 3.4a1.7 1.7 0 1 1 0 3.4 1.7 1.7 0 0 1 0-3.4ZM3.7 8.3h3v9.8h-3V8.3Zm4.8 0h2.9v1.34h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.6v5.42h-3v-4.8c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.88h-3V8.3Z" /></svg>
          <span><small>LinkedIn</small><strong>linkedin.com/in/hugo-sramos</strong></span>
        </a>
        <a class="contact-card" href="https://github.com/hugolsramos01-bit" rel="me">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-3 18.51c.48.09.66-.21.66-.46v-1.77c-2.69.58-3.26-1.14-3.26-1.14-.44-1.12-1.08-1.42-1.08-1.42-.88-.6.07-.59.07-.59.97.07 1.48 1 1.48 1 .86 1.47 2.25 1.04 2.8.8.09-.63.34-1.04.61-1.28-2.15-.24-4.41-1.08-4.41-4.8 0-1.06.38-1.92 1-2.6-.1-.24-.43-1.23.1-2.56 0 0 .82-.26 2.67.99A9.3 9.3 0 0 1 12 6.85a9.3 9.3 0 0 1 2.43.33c1.85-1.25 2.67-.99 2.67-.99.53 1.33.2 2.32.1 2.56.62.68 1 1.54 1 2.6 0 3.73-2.27 4.56-4.43 4.8.35.3.66.87.66 1.76v2.6c0 .25.17.55.67.46A9.5 9.5 0 0 0 12 2.5Z" /></svg>
          <span><small>GitHub</small><strong>github.com/hugolsramos01-bit</strong></span>
        </a>
      </div>
      <p class="contact-location">Localização profissional: <strong>Recife, Pernambuco, Brasil</strong>.</p>
    </div>
  </section>
</BaseLayout>
