---
interface Props {
  index: string;
  title: string;
  summary: string;
  slug: string;
  status?: string;
}

const { index, title, summary, slug, status } = Astro.props;
---

<a class="project-card" href={`/projetos/${slug}`}>
  <div class="project-index">{index}{status ? ` · ${status}` : ''}</div>
  <div>
    <h3>{title}</h3>
    <p>{summary}</p>
  </div>
  <span class="project-arrow" aria-hidden="true">↗</span>
</a>
