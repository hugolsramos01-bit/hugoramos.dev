---
interface Props {
  index: string;
  title: string;
  summary: string;
  slug: string;
  status?: string;
  stack: string[];
}

import ProjectVisual from './ProjectVisual.astro';

const { index, title, summary, slug, status, stack } = Astro.props;
---

<a class="project-card" href={`/projetos/${slug}`}>
  <ProjectVisual slug={slug} stack={stack} />
  <div class="project-card-copy">
    <div class="project-index">{index}{status ? ` · ${status}` : ''}</div>
    <h3>{title}</h3>
    <p>{summary}</p>
  </div>
  <span class="project-arrow" aria-hidden="true">↗</span>
</a>
